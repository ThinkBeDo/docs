              "ai-tools/windsurf"
            ]
          },
          {
            "group": "Updates",
            "pages": [
              "changelogs/2026-01"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoint examples",
            "pages": [
