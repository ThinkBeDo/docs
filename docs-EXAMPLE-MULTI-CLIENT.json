{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "ThinkBeDo Documentation",
  "colors": {
    "primary": "#3B82F6",
    "light": "#60A5FA",
    "dark": "#1E40AF"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
