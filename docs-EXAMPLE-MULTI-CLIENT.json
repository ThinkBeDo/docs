          },
          {
            "group": "Client Name 1",
            "pages": [
              "projects/client1/overview",
              "projects/client1/architecture",
              "projects/client1/setup",
              "projects/client1/deployment"
            ]
          },
          {
            "group": "Client Name 2", 
            "pages": [
              "projects/client2/overview",
